# Google Search Quality Intelligence Platform — Environment Variables Template
# Copy to .env for local environment overrides: cp .env.example .env

PLATFORM_ENV=dev

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=search_quality
DB_USER=postgres
DB_PASSWORD=postgres

# Pydantic Settings Overrides (PLATFORM_PREFIX)
PLATFORM_DATABASE__HOST=localhost
PLATFORM_DATABASE__PORT=5432
PLATFORM_DATABASE__NAME=search_quality
PLATFORM_DATABASE__USER=postgres
PLATFORM_DATABASE__PASSWORD=postgres
